# Copy to .env for ordinary development, or to .env.jury for START_WINDOWS.bat.
# For jury use an empty, dedicated Neon project/database named futurepath_jury.
# Copy pooled and direct strings for the SAME database, role and branch. Keep TLS enabled.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Server-side Groq credentials for jury. Choose a chat model available to this key.
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# Optional outside jury. Default: https://api.groq.com/openai/v1
GROQ_API_URL=""
AI_RATE_LIMIT_PER_HOUR="40"
AI_TIMEOUT_MS="60000"

# Optional jury seed. Set a new, private password of 8 to 128 characters to enable.
# Account: jury@example.test. A seeded account keeps its existing password and data.
JURY_DEMO_PASSWORD=""

# Optional providers for ordinary development (none | anthropic | openai | openai-compatible | antigravity).
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""
ANTIGRAVITY_API_URL=""
ANTIGRAVITY_API_KEY=""
ANTIGRAVITY_MODEL=""

# The Windows jury launcher sets false for local HTTP. Keep the default on Vercel HTTPS.
COOKIE_SECURE=""
# Leave empty to disable /admin.
ADMIN_SECRET=""