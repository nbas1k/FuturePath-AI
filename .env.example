# Скопируйте в .env и заполните. Файл .env НЕ попадает в Git.
# PostgreSQL (Neon): строку берёт владелец проекта из консоли Neon, сюда не вставлять реальные значения
DATABASE_URL=""
# Прямое подключение без пулера (для миграций)
DIRECT_DATABASE_URL=""

# Провайдер ИИ: none | anthropic | openai | openai-compatible | antigravity
# none = ИИ выключен, сайт работает в резервном режиме (честные шаблонные объяснения)
AI_PROVIDER="none"
# Ключ API (только на сервере, никогда не во frontend)
AI_API_KEY=""
# Название модели (например, claude-sonnet-5-5 для anthropic или любая модель вашего провайдера)
AI_MODEL=""
# Только для openai-compatible: адрес API, например https://api.openai.com/v1
AI_BASE_URL=""
# Лимит запросов к ИИ на один профиль в час
AI_RATE_LIMIT_PER_HOUR="40"
# Cookie профиля получает флаг Secure в production. Если сайт открыт по http без HTTPS, поставьте false
COOKIE_SECURE=""

# Antigravity Tools (локальный прокси). AI_PROVIDER="antigravity" включает его.
# Ключ — только здесь, в .env (он не попадает в Git и в браузер).
ANTIGRAVITY_API_URL="http://127.0.0.1:8045/v1"
ANTIGRAVITY_API_KEY=""
ANTIGRAVITY_MODEL=""
# Таймаут ожидания ответа модели, мс (5000–120000)
AI_TIMEOUT_MS="60000"

# Groq API (облачный провайдер, основной для Vercel). Ключ GROQ_API_KEY создаёт владелец в консоли Groq.
# Модель: проверьте актуальный список на https://console.groq.com (или GET /openai/v1/models) и впишите сюда.
GROQ_API_KEY=""
GROQ_MODEL=""
