// База данных: PostgreSQL (Neon). Для локальной разработки и миграций используется прямое подключение.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Демо-профиль: без пароля, привязан к cookie браузера
model Profile {
  id                 String            @id @default(cuid())
  name               String            @default("Гость")
  createdAt          DateTime          @default(now())
  results            TestResult[]
  progress           PlanProgress[] // старая таблица (день плана), больше не используется
  tasks              TaskProgress[]
  aiRecords          AiRecord[]
  selectedProfession String? // выбранная профессия (id из каталога), null — ещё не выбрана
  // --- FuturePath 2.0: онбординг и мотивация (добавлено аддитивно, у всех полей есть значения по умолчанию) ---
  lang               String            @default("ru") // ru | kk | en
  ageGroup           String? // u14 | 14_17 | 18_24 | 25_34 | 35p
  education          String? // school | college | university | working | other
  goal               String? // choose | learn | skills | all
  interests          String            @default("") // id направлений через запятую, до 4
  onboardedAt        DateTime? // null — онбординг не завершён
  dailyGoalXp        Int               @default(20)
  xp                 Int               @default(0)
  streakDays         Int               @default(0)
  lastActiveDay      String? // YYYY-MM-DD
  assessments      Assessment[]
  introAttempts    IntroAttempt[]
  lessonAttempts   LessonAttempt[]
  competencyProgress CompetencyProgress[]
  xpTransactions   XpTransaction[]
  skillChecks        SkillCheck[]
  practiceAnswers    PracticeAnswer[]
  lessonReads        LessonRead[]
  challengeAnswers   ChallengeAnswer[]
  challengeAiHelps   ChallengeAiHelp[]
  simRuns            SimRun[]
  mentorMessages     MentorMessage[]
  interviewRuns      InterviewRun[]
  softRuns           SoftRun[]
  portfolioItems     PortfolioItem[]
  cycleRuns          CycleRun[]
}

// Human + AI Challenge: ответы пользователя. mode "solo" — самостоятельно, "ai" — с подсказками ИИ.
model ChallengeAnswer {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  mode         String
  taskId       String
  answer       Int
  correct      Boolean
  createdAt    DateTime @default(now())

  @@unique([profileId, professionId, mode, taskId])
}

// Подсказка ИИ к заданию режима «с ИИ». Сохраняется, чтобы её нельзя было перегенерировать до удачного ответа.
// correct — совпал ли ответ ИИ с проверенным правильным ответом (ИИ может ошибаться).
model ChallengeAiHelp {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  taskId       String
  choice       Int
  why          String
  correct      Boolean
  createdAt    DateTime @default(now())

  @@unique([profileId, professionId, taskId])
}

// Прохождение симулятора «один день в профессии». choices — JSON-список номеров выбранных вариантов по ситуациям.
model SimRun {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  choices      String   @default("[]")
  finished     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Ответ на задание учебного маршрута. round 1 — первая проверка (диагностика), round 2 — повторная после курса.
model PracticeAnswer {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  round        Int
  taskId       String
  answer       Int
  correct      Boolean
  createdAt    DateTime @default(now())

  @@unique([profileId, professionId, round, taskId])
}

// Урок мини-курса отмечен как прочитанный
model LessonRead {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  lessonId     String
  createdAt    DateTime @default(now())

  @@unique([profileId, professionId, lessonId])
}

// Самооценка навыка пользователя: 0 — пока не умею, 1 — немного, 2 — уверенно.
// ВАЖНО: это САМООЦЕНКА, а не проверенный уровень навыка.
model SkillCheck {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  skill        String
  rating       Int
  updatedAt    DateTime @updatedAt

  @@unique([profileId, professionId, skill])
}

// Результат работы AI-функций (анализ, дорожная карта).
// kind — "analysis" или "roadmap"; basedOn — ключ плана, для которого сделан ответ;
// payload — JSON, уже прошедший проверку структуры; source — "ai" или "rules" (резерв без ИИ).
model AiRecord {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String
  basedOn   String
  source    String
  payload   String
  createdAt DateTime @default(now())
}

// Результат теста: ответы хранятся как JSON-строка {questionId: optionId}
model TestResult {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers   String
  version   Int      @default(1) // версия теста: 1 — 18 вопросов, 2 — 24 вопроса (с интересами)
  createdAt DateTime @default(now())
}

// Отметка выполненного задания плана.
// planKey — версия плана + направления (например "v1:it+design+business"),
// taskId — постоянный id задания внутри плана (например "it-3").
model TaskProgress {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planKey   String
  taskId    String
  done      Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([profileId, planKey, taskId])
}

// СТАРАЯ таблица: отметки по номеру дня. Сохранена, чтобы не удалять данные; код её не использует.
model PlanProgress {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       Int
  done      Boolean @default(true)

  @@unique([profileId, day])
}

// Диалог с AI Mentor: хранится только успешный обмен (вопрос пользователя и настоящий ответ ИИ).
model MentorMessage {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  role         String // "user" | "assistant" | "rule" (правило безопасности, не ИИ)
  content      String
  createdAt    DateTime @default(now())
}

// Пробное собеседование. answers — JSON-список ответов по порядку вопросов; evaluation — разбор ИИ (JSON), пока null — не оценено.
model InterviewRun {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  answers      String   @default("[]")
  evaluation   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Soft Skills Lab: одно прохождение. choices — JSON-список {id ситуации, номер варианта} в порядке прохождения.
model SoftRun {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  choices   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Portfolio Builder: проекты, которые человек добавил сам. skills — JSON-список названий навыков.
model PortfolioItem {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String
  skills      String   @default("[]")
  link        String?
  createdAt   DateTime @default(now())
}

// Единый цикл обучения: один проход по одному навыку профессии.
model CycleRun {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionId String
  skill        String
  futureSeen   Boolean       @default(false)
  aiSkipped    Boolean       @default(false)
  aiFailures   Int           @default(0)
  aiReflection String?
  createdAt    DateTime      @default(now())
  answers      CycleAnswer[]
  hints        CycleAiHelp[]
}

// phase: diag | practice | ai | retest
model CycleAnswer {
  id        String   @id @default(cuid())
  runId     String
  run       CycleRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase     String
  taskId    String
  answer    Int
  correct   Boolean
  createdAt DateTime @default(now())

  @@unique([runId, phase, taskId])
}

// Подсказка ИИ к заданию шага «Человек + ИИ». Хранится, чтобы её нельзя было перегенерировать до удачной.
model CycleAiHelp {
  id      String   @id @default(cuid())
  runId   String
  run     CycleRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId  String
  choice  Int
  why     String
  correct Boolean

  @@unique([runId, taskId])
}

// Диагностика v3. answers — { id вопроса: число }, обновляется атомарно (jsonb ||), result — сохранённый итог.
// Результат всегда пересчитывается на сервере из answers; клиенту не доверяем.
model Assessment {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version     Int       @default(3)
  status      String    @default("in_progress") // in_progress | completed
  answers     Json      @default("{}")
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([profileId, createdAt])
}
// Вводное задание профессии (Этап 4). Результат проверяет сервер; одна запись на профиль и профессию.
model IntroAttempt {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  careerId  String
  choice    Int
  correct   Boolean
  attempts  Int       @default(1)
  solvedAt  DateTime? // когда впервые ответили верно
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([profileId, careerId])
}
// ===== Движок уроков (Этап 5). Контент хранится в БД (его правит админка), начальное наполнение — из src/content через syncContent(). =====
// Тексты — Json вида { ru, en?, kk? }; для недостающих языков явный fallback на ru.
model LearnModule {
  id             String   @id            // например "career:doctor/m1"
  trackId        String                  // "career:<id профессии>" или "skill:<id навыка>"
  order          Int
  title          Json
  summary        Json?
  status         String   @default("draft") // draft | review | published
  expertReviewed Boolean  @default(false)   // проверено ли экспертом; ИИ-материалы по умолчанию нет
  source         String   @default("seed")  // seed — обновляется из src/content; admin — правилась в админке, sync её не трогает
  lessons        Lesson[]

  @@index([trackId, order])
}

model Lesson {
  id            String        @id         // "career:doctor/m1/l1"
  moduleId      String
  module        LearnModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order         Int
  title         Json
  minutes       Int           @default(5)
  objectives    Json          @default("[]")
  theory        Json          @default("[]") // [{ kind: "explain" | "example", text }]
  competencies  Json          @default("[]") // id компетенций, которые развивает урок
  maxXp         Int           @default(20)
  status        String        @default("draft")
  source        String        @default("seed")
  exercises     Exercise[]
  attempts      LessonAttempt[]

  @@index([moduleId, order])
}

model Exercise {
  id            String   @id            // "career:doctor/m1/l1/e1"
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order         Int
  phase         String   @default("check") // first | harder | apply | check
  type          String                     // choice | multi | match | order | fill | text | case | project
  prompt        Json
  data          Json     @default("{}")    // то, что видит ученик (варианты, пары и т.д.)
  answerKey     Json                       // ТОЛЬКО сервер: правильные ответы и критерии
  explanation   Json
  competencies  Json     @default("[]")    // [{ id, weight }]
  verified      Boolean  @default(true)    // false — результат не проверяется автоматически и не даёт баллов компетенции
  source        String   @default("seed")
  answers       ExerciseAnswer[]

  @@index([lessonId, order])
}

model LessonAttempt {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String    @default("in_progress") // in_progress | completed
  score       Float?                             // 0..1, считает сервер
  xpAwarded   Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  answers     ExerciseAnswer[]

  @@index([profileId, lessonId])
}

model ExerciseAnswer {
  id         String        @id @default(cuid())
  attemptId  String
  attempt    LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer     Json
  correct    Boolean
  score      Float                                  // 0..1
  createdAt  DateTime      @default(now())

  @@unique([attemptId, exerciseId])
}

// Освоение компетенции: среднее по лучшим результатам проверенных заданий. Не равно XP.
model CompetencyProgress {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  competencyId String
  score        Float    @default(0)  // 0..1
  evidence     Int      @default(0)  // сколько разных заданий учтено
  updatedAt    DateTime @updatedAt

  @@unique([profileId, competencyId])
}

// XP. Уникальность (профиль, тип, источник) физически не даёт начислить дважды за один и тот же источник.
model XpTransaction {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount     Int
  sourceType String   // lesson | simulation | project | ...
  sourceId   String
  createdAt  DateTime @default(now())

  @@unique([profileId, sourceType, sourceId])
}